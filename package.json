    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.2",
